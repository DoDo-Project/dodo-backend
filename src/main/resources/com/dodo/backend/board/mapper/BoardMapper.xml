<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 게시글(Board) 도메인의 동적 수정 쿼리를 담당하는 MyBatis Mapper XML입니다. -->
<mapper namespace="com.dodo.backend.board.mapper.BoardMapper">

    <!-- if 문을 사용하여 요청 값이 들어온 항목만 선택적으로 수정합니다.
         1. board_title : 게시글 제목
         2. board_content : 게시글 내용
         3. modified_at : 수정 시간
         4. WHERE board_id : boardId를 기준으로 특정 게시글을 식별 -->
    <update id="updateBoard">
        UPDATE board
        <set>
            <if test="request.boardTitle != null and request.boardTitle != ''">board_title = #{request.boardTitle},</if>
            <if test="request.boardContent != null and request.boardContent != ''">board_content = #{request.boardContent},</if>
            modified_at = NOW()
        </set>
        WHERE board_id = #{boardId}
    </update>

    <!-- 특정 게시글의 조회수를 1 증가시킵니다.
         1. view_count : 현재 조회수에 1을 더한 값
         2. WHERE board_id : boardId를 기준으로 특정 게시글을 식별 -->
    <update id="increaseViewCount">
        UPDATE board
        SET view_count = view_count + 1
        WHERE board_id = #{boardId}
    </update>

    <!-- 특정 게시글을 삭제 상태로 변경합니다.
         1. board_status : 삭제를 의미하는 'DELETED' 상태로 변경
         2. board_status_updated_at : 상태 변경 시간
         3. WHERE board_id : boardId를 기준으로 특정 게시글을 식별 -->
    <update id="deleteBoard">
        UPDATE board
        SET board_status = #{status},
            board_status_updated_at = NOW()
        WHERE board_id = #{boardId}
    </update>
</mapper>
